{
  "expo": {
    "name": "Cooking Challenge",
    "slug": "cooking-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myogurucu.cookingchallenge",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.myogurucu.cookingchallenge",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Yemeğinin fotoğrafını çekmek için kamera iznine ihtiyaç var."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF6B35"
        }
      ],
      "expo-font",
      "expo-asset",
      "react-native-google-mobile-ads",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "be4ec699-eb1b-4031-85ed-9070df3f6028"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-2603931978234460~9690317016",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
