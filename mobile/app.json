{
  "expo": {
    "name": "Cooking Challenge",
    "slug": "cooking-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myogurucu.cookingchallenge",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.myogurucu.cookingchallenge",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Yemeğinin fotoğrafını çekmek için kamera iznine ihtiyaç var."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF6B35"
        }
      ]
    ]
  }
}
